# Discord Project Intelligence — example environment file.
#
# PLACEHOLDERS AND SAFE DEFAULTS ONLY. Never put real secrets in this file,
# and never commit a real .env. Copy this file to ".env" (git-ignored) on the
# machine that runs the service, fill in real values there, and restrict file
# permissions.
#
# Validated by src/project_intelligence/config.py (Phase 2).
# Check any configuration non-destructively with:
#   .venv\Scripts\python scripts/validate_config.py    (Windows)
#   .venv/bin/python scripts/validate_config.py        (Linux)
#
# Rules enforced by the application:
# - Integrations are disabled unless explicitly configured (empty = disabled).
# - The dashboard binds to loopback only; remote access is via Tailscale Serve.
# - Ollama must be reached over a loopback address.
# - Discord authorization starts from explicit owner user IDs.
# - Missing allowlists deny everything by default.

# --- Application ---
# APP_ENV: development | testing | production
# Production additionally requires: absolute DATA_DIR, DASHBOARD_SESSION_SECRET_FILE,
# and no placeholder-looking secret values.
APP_ENV=development
# APP_LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
DATA_DIR=data
# Default when unset: <DATA_DIR>/db.sqlite3
DATABASE_PATH=

# --- Discord (enabled only when DISCORD_BOT_TOKEN is set; Phase 10+) ---
# A configured token REQUIRES at least one owner user ID (fail closed).
DISCORD_BOT_TOKEN=
# Comma-separated numeric Discord IDs.
DISCORD_OWNER_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOW_DMS=false

# --- GitHub (read-only; Phase 12+) ---
# GITHUB_MODE: disabled | app | token
GITHUB_MODE=disabled
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_INSTALLATION_ID=
# Comma-separated owner/repo names. Empty = deny all.
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_READ_ONLY_TOKEN=

# --- Ollama (local loopback only; Phase 14+) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave empty until a model is chosen by benchmark (Phase 14).
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120

# --- Research (Phase 15+) ---
# RESEARCH_PROVIDER: none | tavily | brave (empty or none = local research only).
# Web research is disabled without a provider and API key; local knowledge search
# always works and never leaves the machine.
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
# Optional comma-separated bare domains. Empty lets the provider choose domains;
# SSRF/DNS checks, HTTPS-in-production, redirect limits, and response-size limits
# still apply to every fetched page.
RESEARCH_ALLOWED_DOMAINS=
RESEARCH_MAX_RESULTS=10
RESEARCH_MAX_RESPONSE_BYTES=5000000

# --- Dashboard (loopback only; Phases 7-8+) ---
# Non-loopback values are rejected by validation.
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_BIND_PORT=8765
# Required in production; path to a protected file containing the session secret.
DASHBOARD_SESSION_SECRET_FILE=
# Optional public base URL for links back from Discord to the dashboard, e.g.
# https://home3013.tail53635c.ts.net. Never a public/Funnel URL.
DASHBOARD_PUBLIC_URL=

# --- Projects (Phase 6+) ---
# Comma-separated absolute paths a health check may inspect. Empty = deny all.
PROJECT_ALLOWED_ROOTS=

# --- Jobs & limits (Phase 16+) ---
SCHEDULER_ENABLED=false
MAX_CONCURRENT_JOBS=2
MAX_RESEARCH_JOBS_PER_USER=3
MAX_JOB_RUNTIME_SECONDS=600
AUDIT_RETENTION_DAYS=90

# --- Network behavior ---
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2

# --- OpenCode (Phase 17+; disabled by default) ---
OPENCODE_ENABLED=false
OPENCODE_COMMAND=
# Comma-separated absolute worktree paths. Empty = deny all.
OPENCODE_ALLOWED_WORKTREES=
OPENCODE_MAX_RUNTIME_SECONDS=300
