# Discord Project Intelligence — example environment file.
#
# PLACEHOLDERS ONLY. Never put real secrets in this file, and never commit a
# real .env. Copy this file to ".env" (git-ignored) on the machine that runs
# the service, fill in real values there, and restrict file permissions.
#
# The validated configuration schema is introduced in Phase 2. These names
# reflect the planned configuration inventory and may be adjusted then.

# --- Application ---
APP_ENV=development
APP_LOG_LEVEL=INFO
DATA_DIR=
DATABASE_PATH=

# --- Discord (Phase 10+) ---
DISCORD_BOT_TOKEN=
DISCORD_OWNER_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOW_DMS=false

# --- GitHub (read-only; Phase 12+) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_INSTALLATION_ID=
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_READ_ONLY_TOKEN=

# --- Ollama (local only; Phase 14+) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=

# --- Research (Phase 15+) ---
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
RESEARCH_ALLOWED_DOMAINS=
RESEARCH_MAX_RESULTS=
RESEARCH_MAX_RESPONSE_BYTES=

# --- Dashboard (loopback by default; Phases 7-8+) ---
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_BIND_PORT=
DASHBOARD_SESSION_SECRET_FILE=

# --- Feature gates (secure defaults: disabled) ---
OPENCODE_ENABLED=false
SCHEDULER_ENABLED=false
